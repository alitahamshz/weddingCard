# رمز ورود پنل مدیریت مهمان‌ها (آدرس /admin)
# روی Vercel این مقدار را در Settings → Environment Variables تنظیم کنید.
ADMIN_PASSWORD=wedding1405

# تنظیمات دیتابیس آنلاین (Upstash Redis) برای ذخیره ابری مهمان‌ها در Vercel
# در پنل ورسل از تب Storage می‌توانید Upstash Redis رایگان بسازید که این دو متغیر را خودکار ست می‌کند:
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

